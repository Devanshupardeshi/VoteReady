# VoteReady — Environment Variables
# Copy this file to .env and fill in your API keys

# Gemini API (replaces Claude API from original PRD)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps Embed API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Calendar API (OAuth Client ID)
VITE_GOOGLE_CALENDAR_CLIENT_ID=your_google_calendar_client_id_here

# Google Translate API v2
VITE_GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# YouTube Data API v3
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Custom Search JSON API
VITE_GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
VITE_GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here
